# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env НЕ попадает на GitHub (он в .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-ваш-токен

# Ваш Telegram id (узнать можно у бота @userinfobot)
ADMIN_ID=123456789

# Адрес сайта-каталога на GitHub Pages (обязательно https и / в конце)
WEBAPP_URL=https://ваш-логин.github.io/itmo-merch-bot/
